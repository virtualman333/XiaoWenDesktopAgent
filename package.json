{
  "name": "xiaowen-assistant",
  "version": "1.7.0",
  "description": "小问助手 - 常驻桌面右下角的 AI 快捷问答助手",
  "main": "src/main/main.js",
  "author": "yonggui",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "start": "electron .",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "preview": "npm run build:renderer && electron .",
    "test:wake": "node build/_wake_test.mjs",
    "test:pet": "node build/_pet_link_test.mjs",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:dir": "npm run build:renderer && electron-builder --win dir",
    "test:orch": "node build/_orch_test.mjs",
    "test:proactive": "node build/_proactive_test.mjs",
    "test:tray": "node build/_tray_test.mjs",
    "test:packed": "node build/_packed_check.mjs",
    "release:upload": "node build/gh-release.mjs",
    "version:bump": "node build/bump-version.mjs",
    "test:llm": "node build/_llm_test.mjs",
    "test:context": "node build/_context_test.mjs",
    "test:hotkey": "node build/_hotkey_test.mjs",
    "test:pet-top": "node build/_run-electron.mjs build/_pet_top_test.js",
    "test:ui": "node build/_run-electron.mjs build/_ui_smoke.js",
    "test:all": "npm run test:context && npm run test:hotkey && npm run test:proactive && npm run test:orch && npm run test:pet && npm run test:tray && npm run test:wake",
    "test:boot": "node build/_run-electron.mjs build/_boot_check.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "ai.unihub.xiaowen",
    "productName": "小问助手",
    "directories": {
      "output": "release-v1.7.0",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "generateUpdatesFilesForAllChannels": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小问助手",
      "runAfterFinish": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "virtualman333",
      "repo": "XiaoWenDesktopAgent"
    },
    "artifactName": "XiaoWen-Setup-${version}.${ext}"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  }
}
