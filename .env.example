# 复制本文件为 .env 后填入真实值。.env 已在 .gitignore 中，不会被提交。
# 注意：本项目是公开仓库，任何真实密钥一旦提交到 git 历史即视为泄露，请立即在服务商控制台轮换。

# 阿里云百炼（DashScope）API Key —— 用于语音识别 ASR / 语音合成 TTS
# 控制台：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 大模型接口（也可在应用内「设置 → 模型」中填写，会存到 userData/config.json）
# 推荐国内使用 DeepSeek，便宜且快
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
